# Grovia — one environment file for the whole monorepo.
# Copy to .env at the repo root. Never commit .env.
#
#   cp _.env.example .env        (or run: node setup.mjs)
#
# apps/api reads it through config/env.ts; apps/web and apps/admin load it in
# their next.config.ts. There are no per-app .env files for development.
# The template keeps its underscore so it stays visible in Finder and Explorer.

# Runtime
NODE_ENV=development
PORT=8000

# Required — the API refuses to start without these two.
# Local MongoDB, or a free Atlas cluster: mongodb+srv://<user>:<password>@<cluster>/grovia
MONGO_URI=mongodb://127.0.0.1:27017/grovia
# Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-use-openssl-rand-base64-32
JWT_EXPIRES_IN=30d

# App URLs
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# NEXT_PUBLIC_* values are shipped to the browser. Never put a secret in one.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# Everything below is optional, and the starter reads none of it yet. The
# course adds each one in the chapter that needs it, so uncomment them when you
# get there. Leave a value empty and that feature simply stays off.
# ─────────────────────────────────────────────────────────────────────────────

# Sessions (storefront + dashboard cookies)
# SESSION_MAX_AGE=2592000
# SESSION_COOKIE_NAME=grovia_session

# Images: ImageKit (default) or Cloudinary
# IMAGEKIT_PRIVATE_KEY=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Payments: Stripe test keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Email (SMTP)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SENDER_EMAIL_ADDRESS=

# Sign in with Google: callback http://localhost:8000/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Background jobs. Without Redis, jobs run inline in the API process.
# REDIS_URL=redis://127.0.0.1:6379

# Error tracking (Sentry). Without a DSN, nothing is sent.
# NEXT_PUBLIC_SENTRY_DSN_WEB=
# NEXT_PUBLIC_SENTRY_DSN_ADMIN=
# SENTRY_DSN_API=
